<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Talking to Supabase. Flutter's debug manifest grants this implicitly,
         so without declaring it here a release build would fail where debug
         worked. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Reading a picked file. Scoped to API 32 and below: from Android 13 the
         system photo picker and the Storage Access Framework hand back a URI
         the app is already granted, so no storage permission is involved. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- The camera is used through ACTION_IMAGE_CAPTURE, which the camera app
         services on our behalf.

         android.permission.CAMERA is deliberately NOT declared. It is not
         required for the capture intent, and declaring it actively breaks the
         feature: once an app holds the declaration, the platform refuses to
         launch ACTION_IMAGE_CAPTURE until the permission has also been granted
         at runtime — and nothing in this app requests runtime permissions.
         Adding the line without adding that plumbing turns "Scan with camera"
         into a SecurityException. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:label="ai_study_helper"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Package visibility, required from Android 11. Without these the
             intents below resolve to nothing and the picker silently fails to
             open even though the app that handles it is installed. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <data android:mimeType="image/*"/>
        </intent>
        <!-- The PDF entry, via file_selector's Storage Access Framework. -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <data android:mimeType="application/pdf"/>
        </intent>
    </queries>
</manifest>
